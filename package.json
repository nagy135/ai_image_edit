{
  "name": "convex-turbo-demo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --ui tui",
    "dev:web": "turbo dev --filter=web",
    "dev:docker": "turbo dev --filter=@repo/docker",
    "docker:down": "docker compose -f docker-compose.yml down",
    "docker:up": "docker compose -f docker-compose.yml up -d",
    "docker:ps": "docker compose -f docker-compose.yml ps",
    "convex:admin-key": "turbo admin-key --filter=@repo/docker",
    "convex:deploy": "turbo deploy --filter=@repo/convex-backend",
    "build": "turbo build",
    "lint": "turbo lint",
    "stop": "docker compose -f packages/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.3.4"
  },
  "packageManager": "bun@1.1.42",
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "lucide-react": "^0.563.0"
  }
}
